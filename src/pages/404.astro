---
import { SITE_NAME } from '@/config'
import Layout from '../layouts/Layout.astro'
---

<Layout title={`Page not found - ${SITE_NAME}`} noindex>
	<main>
		<p class='code gradient-text'>404</p>
		<h1>Page not found</h1>
		<a href='/'>Back home</a>
	</main>
</Layout>

<style>
	main {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		padding: 6rem 1.5rem;
	}

	.code {
		margin: 0;
		font-size: 6rem;
		font-weight: 800;
		line-height: 1;
	}

	h1 {
		font-size: 1.5rem;
	}

	a {
		color: var(--primary);
		font-weight: 600;
	}
</style>
