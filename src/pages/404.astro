---
import { SITE_NAME } from '@/config'
import Layout from '../layouts/Layout.astro'
---

<Layout title={`Page not found - ${SITE_NAME}`} noindex>
	<main>
		<p class='code gradient-text'>404</p>
		<h1>Page not found</h1>
		<a href='/'>Back home</a>
	</main>
</Layout>

<style>
	main {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		padding: 6rem 1.5rem;
	}

	.code {
		margin: 0;
		font-size: 6rem;
		font-weight: 800;
		line-height: 1;
		transform-origin: top center;
		animation: swing 3s ease-in-out 300ms both;
	}

	/* Adapted from animate.css's swing (https://animate.style, MIT), slowed down and damped gradually so it feels heavy.
	 * Each swing takes the same time, like a pendulum, and loses about a third of its reach */
	@keyframes swing {
		10% {
			transform: rotate(25deg);
		}
		23% {
			transform: rotate(-18deg);
		}
		36% {
			transform: rotate(12deg);
		}
		49% {
			transform: rotate(-8deg);
		}
		62% {
			transform: rotate(5deg);
		}
		75% {
			transform: rotate(-3deg);
		}
		88% {
			transform: rotate(1.5deg);
		}
		to {
			transform: rotate(0deg);
		}
	}

	h1 {
		font-size: 1.5rem;
	}

	a {
		color: var(--primary);
		font-weight: 600;
	}
</style>
