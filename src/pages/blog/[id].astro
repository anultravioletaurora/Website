---
import { render } from 'astro:content'
import { formatPostDate, getPosts, getPostSnippet, type Post } from '@/config/blog'
import { SITE_NAME, socialLinks } from '@/config'
import Layout from '../../layouts/Layout.astro'

export async function getStaticPaths() {
	const posts = await getPosts()
	return posts.map((post) => ({ params: { id: post.id }, props: { post } }))
}

const { post } = Astro.props as { post: Post }
const { Content } = await render(post)
const description = getPostSnippet(post)
const url = new URL(`/blog/${post.id}`, Astro.site).href
// Generated by ./[id].png.ts
const image = `/blog/${post.id}.png`
---

<Layout
	title={`${post.data.title} - ${SITE_NAME}`}
	description={description}
	image={image}
	imageAlt={post.data.title}
	article={{ publishedTime: post.data.date, modifiedTime: post.data.updated }}
	schema={{
		'@type': 'BlogPosting',
		headline: post.data.title,
		description,
		datePublished: post.data.date.toISOString(),
		dateModified: (post.data.updated ?? post.data.date).toISOString(),
		url,
		mainEntityOfPage: { '@type': 'WebPage', '@id': url },
		image: new URL(image, Astro.site).href,
		author: { '@type': 'Person', name: SITE_NAME, url: Astro.site?.href, sameAs: socialLinks.map((link) => link.href) },
	}}
>
	<main>
		<article>
			<a class='back' href='/blog'>← Blog</a>

			<h1>{post.data.title}</h1>
			<p class='meta'>
				<time datetime={post.data.date.toISOString()}>{formatPostDate(post.data.date)}</time>
			</p>

			<Content />
		</article>
	</main>
</Layout>

<style>
	main {
		padding: 3rem 1rem 4rem;
	}

	article {
		max-width: 42rem;
		margin: 0 auto;
	}

	.back {
		color: var(--primary);
		font-weight: 600;
		text-decoration: none;
	}

	h1 {
		margin-top: 1.5rem;
	}

	.meta {
		margin-top: 0.5rem;
		font-weight: 600;
		color: var(--accent);
	}

	/* Markdown output isn't scoped, so style it through :global */
	article :global(h2) {
		margin: 2.5rem 0 0.5rem;
		font-size: 1.25rem;
		font-weight: 700;
	}

	article :global(ul),
	article :global(ol) {
		padding-left: 1.25rem;
	}

	article :global(li + li) {
		margin-top: 0.25rem;
	}

	article :global(a) {
		color: var(--primary);
	}

	article :global(img) {
		max-width: 100%;
		height: auto;
		border-radius: 7px;
	}

	article :global(blockquote) {
		margin: 1.5rem 0;
		padding-left: 1rem;
		border-left: 3px solid var(--accent);
		color: var(--neutral);
	}

	article :global(pre) {
		padding: 1rem;
		border-radius: 7px;
		overflow-x: auto;
	}

	article :global(pre code) {
		padding: 0;
		background: none;
	}

	article :global(code) {
		font-family: var(--font-mono);
		font-size: 0.9em;
		padding: 0.1em 0.3em;
		border-radius: 4px;
		background-color: var(--background-50);
	}
</style>
