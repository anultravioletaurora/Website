---
import { mdiArrowRight } from '@mdi/js'
import Icon from '@/components/Icon.astro'
import { EMAIL, emailLink, SITE_NAME, socialLinks } from '@/config'
import Layout from '../layouts/Layout.astro'
---

<Layout
	title={`Contact - ${SITE_NAME}`}
	description={`Get in touch with ${SITE_NAME}.`}
>
	<main>
		<header>
			<h1>Get in touch</h1>
			<p class='lede'>
				Want to talk about a project, a job, or Jellify? Email is the best way
				to reach me.
			</p>
		</header>

		<section class='email' aria-labelledby='email-heading'>
			<Icon path={emailLink.icon} />
			<h2 id='email-heading'>Send me an email</h2>
			<p>I read everything, and usually reply within a few days.</p>
			<a class='button' href={emailLink.href}>
				Email me
				<Icon path={mdiArrowRight} />
			</a>
			<p class='address'>
				<code>{EMAIL}</code>
			</p>
		</section>

		<section class='elsewhere' aria-labelledby='elsewhere-heading'>
			<h2 id='elsewhere-heading'>Find me elsewhere</h2>
			<ul>
				{socialLinks.map((link) => (
					<li>
						<a href={link.href} rel='me'>
							<Icon path={link.icon} />
							<span>
								<strong>{link.label}</strong>
								<small>{link.description}</small>
							</span>
						</a>
					</li>
				))}
			</ul>
		</section>
	</main>
</Layout>

<style>
	main {
		max-width: 48rem;
		margin: 0 auto;
		padding: 3rem 1rem 4rem;
	}

	h1 {
		margin: 0;
		font-size: 2.5rem;
		font-weight: 800;
		letter-spacing: -0.02em;
		line-height: 1.1;
	}

	.lede {
		margin: 0.75rem 0 0;
		font-size: 1.125rem;
		color: var(--neutral);
	}

	h2 {
		margin: 0;
		font-size: 1.25rem;
		font-weight: 700;
	}

	/* Email */

	.email {
		margin-top: 2.5rem;
		padding: 2.5rem 1.5rem;
		border-radius: 14px;
		text-align: center;
		background:
			linear-gradient(var(--background), var(--background)) padding-box,
			var(--gradient) border-box;
		border: 2px solid transparent;
	}

	.email > :global(.icon) {
		width: 3rem;
		height: 3rem;
		color: var(--accent);
	}

	.email h2 {
		margin-top: 0.5rem;
		font-size: 1.5rem;
	}

	.email p {
		margin: 0.5rem auto 0;
		max-width: 28rem;
		color: var(--neutral);
	}

	.button {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-top: 1.5rem;
		padding: 0.75rem 1.5rem;
		border-radius: 7px;
		background-color: var(--primary);
		color: var(--background);
		font-weight: 700;
		text-decoration: none;
	}

	.button:hover,
	.button:focus-visible {
		box-shadow: 0 8px 24px -8px var(--primary);
	}

	.email .address {
		margin-top: 1rem;
	}

	code {
		font-family: var(--font-mono);
		font-size: 0.9em;
		padding: 0.1em 0.3em;
		border-radius: 4px;
		background-color: var(--background-50);
		color: var(--color);
	}

	/* Other channels */

	.elsewhere {
		margin-top: 3rem;
	}

	ul {
		list-style: none;
		margin: 1rem 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
		gap: 1rem;
	}

	ul a {
		height: 100%;
		display: flex;
		align-items: flex-start;
		gap: 1rem;
		color: var(--color);
		text-decoration: none;
		border: 2px solid var(--border-color);
		border-radius: 14px;
		padding: 1rem 1.25rem;
	}

	ul a:hover,
	ul a:focus-visible {
		border-color: var(--primary);
	}

	ul a :global(.icon) {
		width: 1.5rem;
		height: 1.5rem;
		margin-top: 0.125rem;
		color: var(--primary);
	}

	ul span {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}

	small {
		font-size: 0.9375rem;
		color: var(--neutral);
		overflow-wrap: anywhere;
	}
</style>
