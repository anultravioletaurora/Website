---
import { mdiArrowRight } from '@mdi/js'
import Icon from '@/components/Icon.astro'
import { emailLink, SITE_NAME, socialLinks } from '@/config'
import Layout from '../layouts/Layout.astro'
---

<Layout title={`Contact - ${SITE_NAME}`} description={`Get in touch with ${SITE_NAME}.`}>
	<main>
		<header>
			<h1>Get in touch</h1>
			<p class='lede'>Want to talk about a project, a job, or Jellify? Send me a message and it'll land straight in my inbox.</p>
		</header>

		<section class='email' aria-labelledby='email-heading'>
			<Icon path={emailLink.icon} />
			<h2 id='email-heading'>Send me a message</h2>
			<p>I read everything and usually reply within a few days.</p>

			<form method='post' action='/api/contact'>
				<label>
					Name
					<input name='name' autocomplete='name' maxlength='100' required />
				</label>
				<label>
					Email
					<input
						name='email'
						type='email'
						autocomplete='email'
						maxlength='254'
						required
					/>
				</label>
				<label>
					Message
					<textarea
						name='message'
						rows='6'
						maxlength='5000'
						required
					></textarea>
				</label>
				<!-- Hidden from people, so anything typed here came from a bot -->
				<label class='trap' aria-hidden='true'>
					Website
					<input name='website' tabindex='-1' autocomplete='off' />
				</label>
				<button class='button' type='submit'>
					Send
					<Icon path={mdiArrowRight} />
				</button>
				<p class='status' role='status'></p>
			</form>
		</section>

		<section class='elsewhere' aria-labelledby='elsewhere-heading'>
			<h2 id='elsewhere-heading'>Find me elsewhere</h2>
			<ul>
				{
					socialLinks.map((link) => (
						<li>
							<a href={link.href} rel='me'>
								<Icon path={link.icon} />
								<span>
									<strong>{link.label}</strong>
									<small>{link.description}</small>
								</span>
							</a>
						</li>
					))
				}
			</ul>
		</section>
	</main>
</Layout>

<script>
	const form = document.querySelector<HTMLFormElement>('.email form')!
	const status = form.querySelector<HTMLElement>('.status')!
	const button = form.querySelector<HTMLButtonElement>('button')!
	const SENT = 'Thanks! Your message is on its way.'
	const FAILED = `Your message couldn't be sent. Please try again, or email me directly.`

	function show(message: string, ok: boolean) {
		status.textContent = message
		status.classList.toggle('error', !ok)
		// Restarts the animation so a repeated message still fades in or shakes
		status.style.animation = 'none'
		void status.offsetWidth
		status.style.animation = ''
	}

	// Without JavaScript the form posts normally and the Worker redirects back here with the result
	const result = new URLSearchParams(location.search).get('status')
	if (result === 'sent') show(SENT, true)
	if (result === 'error') show(FAILED, false)

	form.addEventListener('submit', async (event) => {
		event.preventDefault()
		button.disabled = true
		show('Sending…', true)
		try {
			const response = await fetch(form.action, {
				method: 'POST',
				headers: { Accept: 'application/json' },
				body: new FormData(form),
			})
			const body: { ok: boolean; error?: string } = await response.json()
			if (!body.ok) throw new Error(body.error)
			form.reset()
			show(SENT, true)
		} catch (error) {
			show(
				error instanceof Error && error.message ? error.message : FAILED,
				false,
			)
		} finally {
			button.disabled = false
		}
	})
</script>

<style>
	main {
		max-width: 48rem;
		margin: 0 auto;
		padding: 3rem 1rem 4rem;
	}

	.lede {
		margin: 0.75rem 0 0;
		font-size: 1.125rem;
		color: var(--neutral);
	}

	h2 {
		margin: 0;
		font-size: 1.25rem;
		font-weight: 700;
	}

	/* Email */

	.email {
		margin-top: 2.5rem;
		padding: 2.5rem 1.5rem;
		border-radius: 14px;
		text-align: center;
		background:
			linear-gradient(var(--background), var(--background)) padding-box,
			var(--gradient) border-box;
		border: 2px solid transparent;
	}

	.email > :global(.icon) {
		width: 3rem;
		height: 3rem;
		color: var(--accent);
	}

	.email h2 {
		margin-top: 0.5rem;
		font-size: 1.5rem;
	}

	.email p {
		margin: 0.5rem auto 0;
		max-width: 28rem;
		color: var(--neutral);
	}

	.button {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-top: 1.5rem;
		padding: 0.75rem 1.5rem;
		border-radius: 7px;
		background-color: var(--primary);
		color: var(--background);
		font-weight: 700;
		text-decoration: none;
	}

	.button:hover,
	.button:focus-visible {
		box-shadow: 0 8px 24px -8px var(--primary);
	}

	form {
		display: grid;
		gap: 1rem;
		margin: 1.5rem 0 0;
		text-align: left;
	}

	label {
		display: grid;
		gap: 0.375rem;
		font-weight: 700;
	}

	input,
	textarea {
		width: 100%;
		padding: 0.625rem 0.75rem;
		border: 2px solid var(--border-color);
		border-radius: 7px;
		background-color: var(--background);
		color: var(--color);
		font: inherit;
		font-weight: 400;
	}

	textarea {
		resize: vertical;
	}

	input:focus-visible,
	textarea:focus-visible {
		outline: none;
		border-color: var(--primary);
	}

	.trap {
		position: absolute;
		left: -9999px;
	}

	form .button {
		justify-self: center;
		margin-top: 0.5rem;
		border: none;
		font: inherit;
		font-weight: 700;
		cursor: pointer;
	}

	form .button:disabled {
		opacity: 0.6;
		cursor: progress;
	}

	.email .status {
		margin: 0 auto;
		text-align: center;
		color: var(--primary);
		animation: fade-in 200ms ease-out;
	}

	.email .status:empty {
		display: none;
	}

	/* "Sending…" gently fades in and out until the request finishes */
	form:has(.button:disabled) .status {
		animation:
			fade-in 200ms ease-out,
			breathe 1.2s ease-in-out 200ms infinite;
	}

	.email .status.error {
		color: var(--accent);
		animation: shake 500ms ease-in-out;
	}

	.email .address {
		margin-top: 1.5rem;
		font-size: 0.9375rem;
	}

	code {
		font-family: var(--font-mono);
		font-size: 0.9em;
		padding: 0.1em 0.3em;
		border-radius: 4px;
		background-color: var(--background-50);
		color: var(--color);
	}

	/* Other channels */

	.elsewhere {
		margin-top: 3rem;
	}

	ul {
		list-style: none;
		margin: 1rem 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
		gap: 1rem;
	}

	ul a {
		height: 100%;
		display: flex;
		align-items: flex-start;
		gap: 1rem;
		color: var(--color);
		text-decoration: none;
		border: 2px solid var(--border-color);
		border-radius: 14px;
		padding: 1rem 1.25rem;
	}

	ul a:hover,
	ul a:focus-visible {
		border-color: var(--primary);
	}

	ul a :global(.icon) {
		width: 1.5rem;
		height: 1.5rem;
		margin-top: 0.125rem;
		color: var(--primary);
	}

	ul span {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}

	small {
		font-size: 0.9375rem;
		color: var(--neutral);
		overflow-wrap: anywhere;
	}
</style>
