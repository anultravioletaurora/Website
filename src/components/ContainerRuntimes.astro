---
import { mdiApple, mdiDocker } from '@mdi/js'
import Icon from '@/components/Icon.astro'

// Shared Linux VM (Docker Desktop, Colima, Podman) vs. Apple container's VM per container
const appleVms = [
	{ size: 'lg', ip: '192.168.64.2' },
	{ size: 'sm', ip: '192.168.64.3' },
	{ size: 'md', ip: '192.168.64.4' },
]
---

<figure class='runtimes'>
	<div class='panels'>
		<div class='panel'>
			<p class='label'>
				<Icon path={mdiDocker} />
				Docker Desktop, Colima, Podman
			</p>
			<div class='host'>
				<span class='tag'>macOS</span>
				<div class='vm shared'>
					<span class='tag'>One Linux VM, fixed CPU + RAM</span>
					<div class='containers'>
						<span class='ctr'>container</span>
						<span class='ctr'>container</span>
						<span class='ctr'>container</span>
						<span class='reserved'>reserved, sitting idle</span>
					</div>
				</div>
			</div>
			<ul class='notes'>
				<li>Sized up front, used or not</li>
				<li>Ports forwarded host ↔ VM</li>
				<li>VM wedges, every container goes down</li>
			</ul>
		</div>
		<div class='panel apple'>
			<p class='label'>
				<Icon path={mdiApple} />
				Apple <code>container</code>
			</p>
			<div class='host'>
				<span class='tag'>macOS</span>
				<div class='vms'>
					{appleVms.map((vm) => (
						<div class={`vm ${vm.size}`}>
							<span class='ctr'>container</span>
							<span class='ip'>{vm.ip}</span>
						</div>
					))}
					<span class='free'>free memory, back to macOS</span>
				</div>
			</div>
			<ul class='notes'>
				<li>Each VM sized to its job</li>
				<li>Own IP, no port forwarding</li>
				<li>One fails, the rest keep running</li>
			</ul>
		</div>
	</div>
	<figcaption>
		Dashed boxes are VMs. One shared VM for everything, or one tiny VM per
		container.
	</figcaption>
</figure>

<style>
	.runtimes {
		container-type: inline-size;
	}

	.panels {
		display: grid;
		gap: 1rem;
	}

	@container (min-width: 34rem) {
		.panels {
			grid-template-columns: 1fr 1fr;
		}
	}

	.panel {
		display: flex;
		flex-direction: column;
		padding: 1rem;
		border-radius: 14px;
		border: 1px solid var(--border-color);
		background-color: var(--background-25);
	}

	.panel.apple {
		background:
			linear-gradient(var(--background), var(--background)) padding-box,
			var(--gradient) border-box;
		border: 2px solid transparent;
	}

	.label {
		display: flex;
		align-items: center;
		gap: 0.375rem;
		margin: 0 0 0.75rem;
		font-weight: 700;
	}

	.label :global(.icon) {
		color: var(--neutral);
	}

	.apple .label :global(.icon) {
		color: var(--primary);
	}

	.host {
		flex: 1;
		padding: 0.5rem;
		border-radius: 10px;
		border: 1px solid var(--border-color);
	}

	.tag {
		display: block;
		margin-bottom: 0.5rem;
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--neutral);
	}

	.vm {
		border-radius: 7px;
		border: 2px dashed var(--primary);
	}

	.shared {
		padding: 0.5rem;
	}

	.containers {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.375rem;
	}

	.ctr {
		padding: 0.375rem 0.5rem;
		border-radius: 5px;
		background-color: var(--background-50);
		border: 1px solid var(--primary);
		font-size: 0.75rem;
		font-weight: 600;
		text-align: center;
	}

	.reserved,
	.free {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0.375rem 0.5rem;
		border-radius: 5px;
		font-size: 0.75rem;
		font-style: italic;
		text-align: center;
		color: var(--neutral);
	}

	.reserved {
		background: repeating-linear-gradient(
			-45deg,
			transparent 0 6px,
			var(--background-50) 6px 12px
		);
	}

	.vms {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		gap: 0.375rem;
	}

	.vms .vm {
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		gap: 0.25rem;
		padding: 0.25rem;
	}

	/* Different heights stand in for each VM being sized to its own job */
	.vm.sm {
		min-height: 3.5rem;
	}

	.vm.md {
		min-height: 4.5rem;
	}

	.vm.lg {
		min-height: 5.5rem;
	}

	.ip {
		font-family: var(--font-mono);
		font-size: 0.625rem;
		text-align: center;
		color: var(--neutral);
	}

	.free {
		flex: 1;
		min-width: 6rem;
		align-self: stretch;
		border: 1px dashed var(--border-color);
	}

	.notes {
		margin: 0.75rem 0 0;
		font-size: 0.875rem;
		color: var(--neutral);
	}
</style>
