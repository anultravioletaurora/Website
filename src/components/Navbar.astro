---
import { navLinks, socialLinks } from '@/config'
import Icon from './Icon.astro'

// GitHub and LinkedIn stay one tap away in the header; the rest live in the footer and on /contact
const quickLinks = socialLinks.filter((link) => ['GitHub', 'LinkedIn'].includes(link.label))

// The home page's large photo claims the avatar's view transition name, and a name can only be used once per page
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/index.html'
---

<header>
	<nav aria-label='Main'>
		<a class='brand' href='/'>
			<img class:list={['avatar', { transition: !isHome }]} src='/avatar.webp' alt='' width='36' height='36' />
			<span>Violet Caulfield</span>
		</a>

		<ul class='pages'>
			{navLinks.map((link) => (
				<li>
					<a href={link.href}>{link.label}</a>
				</li>
			))}
		</ul>

		<ul class='social'>
			{quickLinks.map((link) => (
				<li>
					<a
						href={link.href}
						rel='me'
						aria-label={link.label}
						title={link.label}
					>
						<Icon path={link.icon} />
					</a>
				</li>
			))}
		</ul>
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		background-color: var(--background-75);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid
			color-mix(in srgb, var(--border-color) 40%, transparent);
	}

	nav {
		max-width: 64rem;
		margin: 0 auto;
		padding: 0.75rem 1rem;
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	a {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		color: var(--color);
		text-decoration: none;
		border-radius: 7px;
	}

	.brand {
		margin-right: auto;
		font-size: 1.125rem;
		font-weight: 700;
		gap: 0.625rem;
	}

	/* Same gradient ring as the home page photo, so it stands out from the dark header */
	.avatar {
		width: 2.25rem;
		height: 2.25rem;
		padding: 2px;
		border-radius: 50%;
		object-fit: cover;
		background: var(--gradient);
	}

	.avatar.transition {
		view-transition-name: avatar;
	}

	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		gap: 0.25rem;
	}

	.pages a {
		font-weight: 600;
		padding: 0.375rem 0.75rem;
	}

	.social {
		padding-left: 0.75rem;
		border-left: 1px solid
			color-mix(in srgb, var(--border-color) 40%, transparent);
	}

	.social a {
		padding: 0.375rem;
	}

	a:hover,
	a:focus-visible {
		color: var(--primary);
		background-color: var(--background-50);
	}

	.brand:hover,
	.brand:focus-visible {
		background-color: transparent;
	}

	/* Logo, pages, and two icons are all that fit on phones */
	@media (max-width: 40rem) {
		nav {
			gap: 0.25rem;
		}

		.brand span {
			display: none;
		}

		.pages a {
			padding: 0.375rem 0.5rem;
			font-size: 0.9375rem;
		}

		.social {
			padding-left: 0.25rem;
		}
	}
</style>
