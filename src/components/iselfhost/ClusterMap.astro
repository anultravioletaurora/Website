---
// Network and node layout of the rack, grouped by Nomad datacenter
const datacenters = [
	{
		name: 'Cosmonautical',
		role: 'Nomad + Consul servers and clients',
		switchName: 'USW Aggregation',
		speed: '10 Gbit',
		fast: true,
		nodes: ['orion', 'taurus', 'cassiopeia*'],
		hardware: 'M4 Pro, 24GB',
		extra: '*Thunderbolt DAS (10 HDDs) on cassiopeia',
	},
	{
		name: 'Jellify',
		role: 'Nomad clients, GitHub Actions runners',
		switchName: 'USW-24',
		speed: '1 Gbit',
		fast: false,
		nodes: ['galileo', 'hopper', 'lovelace'],
		hardware: 'M4, 16GB',
		extra: '+ x64 Linux nodes',
	},
]
---

<figure class='cluster'>
	<div class='router'>
		<strong>Dream Machine Pro</strong>
		<span>router and UniFi OS console</span>
	</div>
	<div class='datacenters'>
		{datacenters.map((dc) => (
			<div class:list={['dc', { fast: dc.fast }]}>
				<div class='switch'>
					<span>{dc.switchName}</span>
					<span class='speed'>{dc.speed}</span>
				</div>
				<p class='name'>{dc.name}</p>
				<p class='role'>{dc.role}</p>
				<ul class='nodes'>
					{dc.nodes.map((node) => (
						<li>{node}</li>
					))}
				</ul>
				<p class='hardware'>{dc.hardware}</p>
				<p class='extra'>{dc.extra}</p>
			</div>
		))}
	</div>
	<div class='storage'>
		<strong>UNAS Pro 8</strong>
		<span>NFS shares (music, books, ROMs) mounted across the cluster</span>
	</div>
	<figcaption>
		Two Nomad datacenters, one rack. Only Cosmonautical gets the 10 Gbit
		backbone.
	</figcaption>
</figure>

<style>
	.cluster {
		--link: 1.25rem;
	}

	.router,
	.storage {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: baseline;
		gap: 0.25rem 0.5rem;
		padding: 0.625rem 1rem;
		border-radius: 10px;
		border: 1px solid var(--border-color);
		background-color: var(--background-25);
		text-align: center;
	}

	.router span,
	.storage span {
		font-size: 0.875rem;
		color: var(--neutral);
	}

	.storage {
		margin-top: 1rem;
		border-style: dashed;
	}

	/* Uplinks: a bus under the router with a drop into each datacenter */
	.datacenters {
		position: relative;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.75rem;
		margin-top: calc(var(--link) * 2);
	}

	.datacenters::before {
		content: '';
		position: absolute;
		top: calc(var(--link) * -1);
		left: 25%;
		right: 25%;
		border-top: 2px solid var(--border-color);
	}

	.datacenters::after {
		content: '';
		position: absolute;
		top: calc(var(--link) * -2);
		left: 50%;
		height: var(--link);
		border-left: 2px solid var(--border-color);
	}

	.dc {
		position: relative;
		padding: 0.75rem;
		border-radius: 14px;
		border: 1px solid var(--border-color);
		background-color: var(--background-25);
	}

	.dc::before {
		content: '';
		position: absolute;
		top: calc(var(--link) * -1);
		left: 50%;
		height: var(--link);
		border-left: 2px solid var(--border-color);
	}

	.dc.fast {
		background:
			linear-gradient(var(--background), var(--background)) padding-box,
			var(--gradient) border-box;
		border: 2px solid transparent;
	}

	.dc.fast::before {
		border-left: 4px solid var(--primary);
		margin-left: -1px;
	}

	.switch {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.25rem;
		padding: 0.375rem 0.5rem;
		border-radius: 5px;
		background-color: var(--background-50);
		font-size: 0.75rem;
		font-weight: 600;
	}

	.speed {
		color: var(--neutral);
	}

	.fast .speed {
		color: var(--accent);
	}

	.name {
		margin: 0.75rem 0 0;
		font-weight: 700;
	}

	.role,
	.hardware,
	.extra {
		margin: 0.125rem 0 0;
		font-size: 0.75rem;
		color: var(--neutral);
	}

	.nodes {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		margin: 0.625rem 0 0;
		padding: 0;
		list-style: none;
	}

	.nodes li {
		margin: 0;
		padding: 0.25rem 0.5rem;
		border-radius: 5px;
		border: 1px solid var(--primary);
		font-family: var(--font-mono);
		font-size: 0.8125rem;
	}

	.hardware {
		margin-top: 0.375rem;
	}

	.extra {
		margin-top: 0.5rem;
		font-style: italic;
	}
</style>
