---
// Front view of the two RackMac Mini shelves, top to bottom as they sit in the rack
const enclosures = [
	{
		datacenter: 'Cosmonautical',
		core: true,
		nodes: [
			{ name: 'orion', chip: 'M4 Pro', memory: '24GB' },
			{ name: 'taurus', chip: 'M4 Pro', memory: '24GB' },
			{
				name: 'cassiopeia',
				chip: 'M4 Pro',
				memory: '24GB',
				extra: '+ Thunderbolt DAS, 10 HDDs',
			},
		],
	},
	{
		datacenter: 'Jellify',
		core: false,
		nodes: [
			{ name: 'galileo', chip: 'M4', memory: '16GB' },
			{ name: 'hopper', chip: 'M4', memory: '16GB' },
			{ name: 'lovelace', chip: 'M4', memory: '16GB' },
		],
	},
]
---

<figure class='rack'>
	{enclosures.map((enclosure) => (
		<div class:list={['enclosure', { core: enclosure.core }]}>
			<div class='faceplate'>
				<span class='model'>RackMac Mini · 2U</span>
				<span class='datacenter'>{enclosure.datacenter}</span>
			</div>
			<ul class='bays'>
				{enclosure.nodes.map((node) => (
					<li>
						<span class='name'>{node.name}</span>
						<span class='chip'>{node.chip}</span>
						<span class='memory'>{node.memory}</span>
						{node.extra && <span class='extra'>{node.extra}</span>}
					</li>
				))}
			</ul>
		</div>
	))}
	<figcaption>
		Two shelves, three Minis each, one Nomad datacenter per shelf.
	</figcaption>
</figure>

<style>
	.rack {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.enclosure {
		padding: 0.75rem;
		border-radius: 14px;
		border: 1px solid var(--border-color);
		background-color: var(--background-25);
	}

	.enclosure.core {
		background:
			linear-gradient(var(--background), var(--background)) padding-box,
			var(--gradient) border-box;
		border: 2px solid transparent;
	}

	.faceplate {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.25rem;
		padding: 0.375rem 0.5rem;
		border-radius: 5px;
		background-color: var(--background-50);
		font-size: 0.75rem;
		font-weight: 600;
	}

	.model {
		color: var(--neutral);
	}

	.core .datacenter {
		color: var(--primary);
	}

	.bays {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.5rem;
		margin: 0.625rem 0 0;
		padding: 0;
		list-style: none;
	}

	.bays li {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.25rem;
		min-width: 0;
		margin: 0;
		padding: 0.625rem 0.375rem;
		border-radius: 7px;
		border: 1px solid var(--primary);
		text-align: center;
	}

	.name {
		max-width: 100%;
		overflow-wrap: anywhere;
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		font-weight: 600;
	}

	.chip {
		padding: 0.125rem 0.375rem;
		border-radius: 4px;
		background-color: var(--background-50);
		font-size: 0.6875rem;
		font-weight: 700;
	}

	.core .chip {
		color: var(--primary);
	}

	.memory {
		font-size: 0.75rem;
		color: var(--neutral);
	}

	.extra {
		font-size: 0.6875rem;
		font-style: italic;
		color: var(--neutral);
	}
</style>
