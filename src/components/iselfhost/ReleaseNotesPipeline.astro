---
// The generate-release-notes composite action, from tags to announcements
const steps = [
	{
		title: 'Work out the tag',
		detail: 'Last store release, or last tag of either kind for OTA',
	},
	{
		title: 'Collect the changes',
		detail: 'Merged PRs, closed issues, contributors',
	},
	{
		title: 'Write the narrative',
		detail: 'gemma4:12b on Ollama, via Open WebUI',
		onCluster: true,
	},
	{ title: 'Ship it', detail: 'TestFlight, Discord, GitHub release' },
]
---

<figure class='pipeline'>
	<ol class='steps'>
		{steps.map((step, i) => (
			<li class:list={['step', { cluster: step.onCluster }]}>
				<span class='number'>{i + 1}</span>
				<strong>{step.title}</strong>
				<span class='detail'>{step.detail}</span>
				{step.onCluster && <span class='badge'>Cosmonautical</span>}
			</li>
		))}
	</ol>
	<figcaption>
		The one place the Jellify datacenter reaches into Cosmonautical: borrowing
		its LLM capabilities.
	</figcaption>
</figure>

<style>
	.pipeline {
		container-type: inline-size;
	}

	.steps {
		display: grid;
		gap: 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.step {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		margin: 0;
		padding: 0.75rem;
		border-radius: 10px;
		border: 1px solid var(--border-color);
		background-color: var(--background-25);
		font-size: 0.875rem;
	}

	.step:not(:last-child)::after {
		content: '↓';
		position: absolute;
		top: 100%;
		left: 50%;
		transform: translateX(-50%);
		font-weight: 700;
		color: var(--neutral);
	}

	.step.cluster {
		background:
			linear-gradient(var(--background), var(--background)) padding-box,
			var(--gradient) border-box;
		border: 2px solid transparent;
	}

	.number {
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--accent);
	}

	.detail {
		font-size: 0.75rem;
		color: var(--neutral);
	}

	.badge {
		align-self: flex-start;
		margin-top: 0.25rem;
		padding: 0.125rem 0.375rem;
		border-radius: 4px;
		background-color: var(--background-50);
		font-size: 0.6875rem;
		font-weight: 600;
		color: var(--primary);
	}

	@container (min-width: 36rem) {
		.steps {
			grid-template-columns: repeat(4, 1fr);
		}

		.step:not(:last-child)::after {
			content: '→';
			top: 50%;
			left: auto;
			right: -1.125rem;
			transform: translateY(-50%);
		}
	}
</style>
