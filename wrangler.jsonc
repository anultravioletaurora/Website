/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "violetcaulfield-website",
	"main": "./worker/index.ts",
	"compatibility_date": "2026-10-01",
	"observability": {
		"enabled": true
	},
	/**
	 * The domain's DNS is on Cloudflare, so the first deploy creates the DNS record and certificate
	 * https://developers.cloudflare.com/workers/configuration/routing/custom-domains/
	 */
	"routes": [{ "pattern": "violetcaulfield.com", "custom_domain": true }],
	/**
	 * Custom domain routes turn workers.dev and preview URLs off by default, and every production deploy syncs that
	 * setting, so keep previews on for PR builds
	 * https://developers.cloudflare.com/workers/configuration/previews/
	 */
	"preview_urls": true,
	/**
	 * The site is static, so the Worker only runs for the contact form's endpoint and everything else is served
	 * straight from the build output
	 * https://developers.cloudflare.com/workers/static-assets/
	 */
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		"run_worker_first": ["/api/*"]
	},
	/**
	 * Sends contact form messages. The recipient is the CONTACT_TO secret, which has to be a verified
	 * Email Routing destination address
	 * https://developers.cloudflare.com/email-routing/email-workers/send-email-workers/
	 */
	"send_email": [{ "name": "CONTACT_EMAIL" }]
}
